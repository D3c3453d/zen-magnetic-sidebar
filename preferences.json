[
	{
		"type": "checkbox",
		"property": "magnetic_sidebar.move_tabs",
		"label": "Move the tab sidebar to the screen edge nearest to the window",
		"defaultValue": true
	},
	{
		"type": "checkbox",
		"property": "magnetic_sidebar.invert_tabs",
		"label": "Invert: keep the sidebar on the side away from the nearest edge",
		"defaultValue": false,
		"conditions": [
			{
				"if": {
					"property": "magnetic_sidebar.move_tabs",
					"value": true
				}
			}
		]
	},
	{
		"type": "checkbox",
		"property": "magnetic_sidebar.move_window_controls",
		"label": "Let the mod place the window controls",
		"defaultValue": true
	},
	{
		"type": "checkbox",
		"property": "magnetic_sidebar.controls_outside_sidebar",
		"label": "Keep the window controls out of the sidebar, in the toolbar (off = inside the sidebar header)",
		"defaultValue": true,
		"conditions": [
			{
				"if": {
					"property": "magnetic_sidebar.move_window_controls",
					"value": true
				}
			}
		]
	}
]
